{
    "name": "spinningcatstudios/farducks-batter-rewards",
    "description": "Farducks' Batter Rewards: a backend that creates a Lingara lesson plan while the order fries, then reads it back by its id.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "spinningcatstudios/lingara": "v0.1.0-alpha.10",
        "nyholm/psr7": "^1.8",
        "symfony/http-client": "^7.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Farducks\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Farducks\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit tests"
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "sort-packages": true
    }
}
